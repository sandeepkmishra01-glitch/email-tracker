BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./tracker.db
ADMIN_USER=admin
ADMIN_PASS=          # required: set a long random value (the dashboard stays locked without it)
# Optional SMTP sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Privacy (defaults shown)
STORE_FULL_IP=false      # false = store IPs truncated to /24 (IPv4) or /48 (IPv6)
SCRUB_AFTER_DAYS=90      # blank IP + user agent on events older than this (0 = keep forever)
